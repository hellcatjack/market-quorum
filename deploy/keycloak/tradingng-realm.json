{
  "realm": "tradingng",
  "enabled": true,
  "attributes": {"frontendUrl": "https://ushome.amycat.com"},
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "roles": {
    "realm": [
      {"name": "User"},
      {"name": "Admin"}
    ]
  },
  "users": [
    {
      "username": "${TRADINGNG_INITIAL_ADMIN_USERNAME}",
      "email": "platform-admin@amycat.com",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["Admin"],
      "credentials": [
        {
          "type": "password",
          "value": "${TRADINGNG_INITIAL_ADMIN_PASSWORD}",
          "temporary": true
        }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "subject (sub)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "lightweight.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true"},
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true"},
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "emailVerified",
            "claim.name": "email_verified",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "roles",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "false"},
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {"name": "assessments:read", "protocol": "openid-connect"},
    {"name": "assessments:submit", "protocol": "openid-connect"},
    {"name": "assessments:cancel", "protocol": "openid-connect"},
    {"name": "assessments:review", "protocol": "openid-connect"},
    {"name": "assessments:admin", "protocol": "openid-connect"},
    {"name": "validations:read", "protocol": "openid-connect"},
    {"name": "validations:write", "protocol": "openid-connect"},
    {"name": "system:read", "protocol": "openid-connect"},
    {"name": "artifacts:read", "protocol": "openid-connect"},
    {"name": "users:manage", "protocol": "openid-connect"},
    {
      "name": "tradingng-api-resource",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "tradingng-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "tradingng-api",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "tradingng-mcp-resource",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "tradingng-mcp-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "https://ushome.amycat.com/mcp",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "tradingng-web",
      "enabled": true,
      "publicClient": false,
      "secret": "${OAUTH2_PROXY_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://ushome.amycat.com/oauth2/callback"],
      "webOrigins": ["https://ushome.amycat.com"],
      "defaultClientScopes": ["basic", "profile", "email", "roles", "assessments:read", "assessments:submit", "assessments:cancel", "assessments:review", "assessments:admin", "validations:read", "validations:write", "system:read", "artifacts:read", "users:manage", "tradingng-api-resource"],
      "optionalClientScopes": []
    },
    {
      "clientId": "tradingng-api",
      "enabled": true,
      "publicClient": false,
      "secret": "${TRADINGNG_API_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic", "assessments:read", "assessments:submit", "assessments:cancel", "assessments:review", "validations:read", "validations:write", "system:read", "artifacts:read", "tradingng-api-resource"]
    },
    {
      "clientId": "tradingng-mcp",
      "enabled": true,
      "publicClient": false,
      "secret": "${TRADINGNG_MCP_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic", "assessments:read", "assessments:submit", "assessments:cancel", "assessments:review", "validations:read", "validations:write", "system:read", "artifacts:read", "tradingng-api-resource", "tradingng-mcp-resource"]
    },
    {
      "clientId": "tradingng-user-admin",
      "enabled": true,
      "publicClient": false,
      "secret": "${TRADINGNG_KEYCLOAK_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": []
    }
  ]
}
