# Optional test or rollback override. Production reads DB_* from the project .env.
# TRADINGNG_DATABASE_URL=postgresql+psycopg://tradingng:change-me@127.0.0.1:5432/tradingng
TRADINGNG_DATA_DIR=/app/devs/TradingNG/var
TRADINGNG_GATEWAY_URL=http://127.0.0.1:8000
# StockLean is the only Alpha data service. Use the same generated token as
# STOCKLEAN_INTERNAL_DATA_TOKEN in StockLean's private backend environment.
TRADINGNG_STOCKLEAN_URL=http://127.0.0.1:8021
TRADINGNG_STOCKLEAN_INTERNAL_TOKEN=
TRADINGNG_STOCKLEAN_TIMEOUT_SECONDS=15
TRADINGNG_STOCKLEAN_READINESS_POLL_SECONDS=15
TRADINGNG_OIDC_ISSUER=https://ushome.amycat.com/realms/tradingng
TRADINGNG_OIDC_AUDIENCE=tradingng-api
TRADINGNG_MCP_RESOURCE_URI=https://ushome.amycat.com/mcp
# Optional exact comma-separated browser origins. An empty value rejects supplied Origin headers.
TRADINGNG_MCP_ALLOWED_ORIGINS=https://ushome.amycat.com
# Required only in the environment of the local authenticated MCP stdio process.
TRADINGNG_MCP_TOKEN=
TRADINGNG_TOKEN_PEPPER=replace-with-a-long-random-secret
TRADINGNG_POSTGRES_PASSWORD=
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=
OAUTH2_PROXY_CLIENT_SECRET=
# Exactly 16, 24, or 32 raw characters; `openssl rand -hex 16` produces 32.
OAUTH2_PROXY_COOKIE_SECRET=
TRADINGNG_API_CLIENT_SECRET=
TRADINGNG_MCP_CLIENT_SECRET=
TRADINGNG_KEYCLOAK_ADMIN_URL=http://127.0.0.1:18081
TRADINGNG_KEYCLOAK_ADMIN_REALM=tradingng
TRADINGNG_KEYCLOAK_ADMIN_CLIENT_ID=tradingng-user-admin
TRADINGNG_KEYCLOAK_ADMIN_CLIENT_SECRET=
TRADINGNG_INITIAL_ADMIN_USERNAME=
TRADINGNG_INITIAL_ADMIN_PASSWORD=
TRADINGNG_ALLOWED_ORIGINS=https://ushome.amycat.com
# Required: URL-safe base64 Fernet key generated from 32 random bytes.
TRADINGNG_WEBHOOK_ENCRYPTION_KEY=
# Optional comma-separated hostnames allowed to resolve to private addresses.
TRADINGNG_WEBHOOK_PRIVATE_HOST_ALLOWLIST=
# SEC asks automated clients to identify their application. Use a public project
# URL or an installation-specific contact; never commit a private email address.
TRADINGNG_SEC_USER_AGENT=MarketQuorum/0.1 (+https://ushome.amycat.com)
TRADINGNG_SEC_REQUEST_TIMEOUT_SECONDS=10
TRADINGNG_MAX_RUNNING_VALIDATION=2
TRADINGNG_VALIDATION_PRICE_PROVIDERS=stocklean
TRADINGNG_VALIDATION_PROVIDER_TIMEOUT_SECONDS=15
