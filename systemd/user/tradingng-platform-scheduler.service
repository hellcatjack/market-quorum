[Unit]
Description=TradingNG capacity-aware admission scheduler
After=tradingng-platform-api.service tradingng-codex-gateway.service
Requires=tradingng-platform-api.service
PartOf=tradingng-platform-api.service
Wants=tradingng-codex-gateway.service
Wants=tradingng-platform-workers.target

[Service]
Type=simple
WorkingDirectory=/app/devs/TradingNG
EnvironmentFile=/app/devs/TradingNG/.env.platform
Environment=PYTHONPATH=/app/devs/TradingNG/platform/src:/app/devs/TradingNG/TradingAgents
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/app/devs/TradingNG/.venv/bin/python /app/devs/TradingNG/scripts/check_platform_database.py
ExecStart=/app/devs/TradingNG/.venv/bin/python -m tradingng_platform.scheduler.main
Restart=always
RestartSec=5
NoNewPrivileges=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
